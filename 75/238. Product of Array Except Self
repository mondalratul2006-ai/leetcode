
class Solution {
    public int[] productExceptSelf(int[] nums) {
        int[] sum = new int[nums.length];
        sum[0] = 1;
        
        for (int i = 1; i < nums.length; i++) {
            sum[i] = sum[i - 1] * nums[i - 1];
        }

        

        int suffix = 1;
        for (int j = nums.length - 1; j >= 0; j--) {
            sum[j] *= suffix;
            suffix *= nums[j];
        }

        return sum;
    }
}
